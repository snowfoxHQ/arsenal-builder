# 生产环境配置模板（仅当 ALIPAY_ENV=production 时使用）
# 沙箱不需要本文件：沙箱直接读取项目根的 .alipay-sandbox.json

ALIPAY_ENV=production
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 支付宝开放平台生产应用
ALIPAY_APP_ID=
# 应用私钥（PKCS#1 裸 Base64，无 PEM 头尾、无换行、无空格）
ALIPAY_APP_PRIVATE_KEY=
# 支付宝公钥（裸 Base64）
ALIPAY_PUBLIC_KEY=
# 卖家支付宝用户 ID（2088 开头）
ALIPAY_SELLER_ID=
# 服务市场注册所得的真实 serviceId（沙箱的 api_mock_service_id 必须替换）
ALIPAY_SERVICE_ID=
ALIPAY_SELLER_NAME=Arsenal

# 订单库位置；生产请指向具备事务与唯一约束的持久化存储
ARSENAL_ORDERS_DB=
